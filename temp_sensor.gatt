PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "Pico2W-LED-PWM"

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

// Custom Service for LED & PWM Control (Service UUID: 0xFF10)
PRIMARY_SERVICE, FF10

// Characteristic 1: Pico 2 W On-board LED Control (UUID: 0xFF11, 1 Byte: 0 = OFF, 1 = ON)
CHARACTERISTIC, FF11, READ | WRITE | WRITE_WITHOUT_RESPONSE | DYNAMIC,

// Characteristic 2: PWM Duty Cycle Control (UUID: 0xFF12, 1 Byte: 0 ~ 255)
CHARACTERISTIC, FF12, READ | WRITE | WRITE_WITHOUT_RESPONSE | DYNAMIC,
